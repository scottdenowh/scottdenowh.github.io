rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Artist photos from the admin portal (osd/artists.html)
    match /artist-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Static branding (e.g. dashboard / install page logos)
    match /artist_images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
